{
  "name": "gradus-analyst",
  "version": "0.3.1",
  "description": "The Gradus Harmonic Analyzer \u2014 music theory analysis in TypeScript: Roman numerals, key detection, modulation and cadence classification, pedal points, texture, voice-leading checks. Reads MusicXML. No Python, runs anywhere JavaScript does. From Gradus, the music-composition curriculum for homeschool families.",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./musicxml/parser": {
      "types": "./dist/musicxml/parser.d.ts",
      "default": "./dist/musicxml/parser.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "test": "node --test test/*.test.mjs",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "music theory",
    "music analysis",
    "roman numeral analysis",
    "harmonic analysis",
    "musicxml",
    "key detection",
    "modulation",
    "cadence",
    "pedal point",
    "voice leading",
    "counterpoint",
    "music21",
    "music",
    "notation",
    "tonal"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/delmas41/gradus-analyst.git"
  },
  "homepage": "https://gradusmusic.com",
  "author": "Sean Johnson \u2014 Gradus School of Music Composition",
  "dependencies": {
    "fast-xml-parser": "^4.3.0",
    "jszip": "^3.10.0"
  },
  "devDependencies": {
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=18"
  }
}
